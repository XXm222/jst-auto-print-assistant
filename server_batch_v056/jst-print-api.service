[Unit]
Description=JST print planner HTTPS backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jst-print-api
Group=jst-print-api
WorkingDirectory=/opt/jst-erp-bridge
Environment=HOME=/var/lib/jst-print-api
Environment=LANG=C.UTF-8
Environment=TZ=Asia/Shanghai
Environment=JST_PRINT_LEASE_DB=/var/lib/jst-print-api/leases.sqlite3
Environment=JST_PRINT_CANDIDATE_CACHE=/var/lib/jst-print-api/candidate-orders-v1.json
Environment=JST_PRINT_BRIDGE_ROOT=/opt/jst-erp-bridge
Environment=JST_PRINT_PLANNER=/opt/jst-print-api/jst_print_shadow_plan.py
Environment=JST_PRINT_LOOKBACK_HOURS=168
Environment=JST_PRINT_LEASE_TTL_SECONDS=900
Environment=JST_PRINT_PLANNER_TIMEOUT_SECONDS=105
Environment=JST_PRINT_INSPECT_TIMEOUT_SECONDS=35
Environment=JST_PRINT_MAX_PLANNER_CONCURRENCY=2
Environment=JST_PRINT_HTTP_IO_TIMEOUT_SECONDS=15
Environment=JST_PRINT_INSPECT_PROOF_CACHE_SECONDS=30
Environment=JST_PRINT_PLAN_CACHE_SECONDS=10
Environment=JST_PRINT_PLAN_CACHE_STALE_SECONDS=60
EnvironmentFile=/etc/jst-print-api.env
ExecStart=/usr/bin/python3 /opt/jst-print-api/jst_print_api_server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StateDirectory=jst-print-api
StateDirectoryMode=0700
ReadWritePaths=/var/lib/jst-print-api
TasksMax=64
MemoryMax=768M
UMask=0077

[Install]
WantedBy=multi-user.target
